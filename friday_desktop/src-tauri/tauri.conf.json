{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FRIDAY",
  "version": "0.1.0",
  "identifier": "com.friday.desktop",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://127.0.0.1:8770"
  },
  "app": {
    "windows": [
      {
        "title": "FRIDAY",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
